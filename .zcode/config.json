{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "^Bash$",
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": ["scripts/guard-bash.mjs"],
              "timeoutMs": 5000,
              "statusMessage": "安全围栏检查"
            }
          ]
        }
      ]
    }
  }
}
